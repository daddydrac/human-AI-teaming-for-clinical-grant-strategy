# syntax=docker/dockerfile:1.7
ARG APP_VERSION=0.8.0
FROM python:3.12-slim
ARG APP_VERSION
LABEL org.opencontainers.image.title="Research Clinic Grant Agent" org.opencontainers.image.version="${APP_VERSION}"
RUN apt-get update && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libcairo2 libffi8 shared-mime-info fonts-liberation curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY renderer/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
COPY renderer/app.py .
COPY config /app/config
EXPOSE 8090
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8090"]
