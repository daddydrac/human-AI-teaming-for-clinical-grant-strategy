# syntax=docker/dockerfile:1.7
ARG APP_VERSION=0.8.0
FROM python:3.12-slim
ARG APP_VERSION
LABEL org.opencontainers.image.title="Clinical Grant HTML Ingestion" org.opencontainers.image.version="${APP_VERSION}"
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
WORKDIR /app
COPY ingestion/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install --no-cache-dir -r requirements.txt \
    && python -m playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright
COPY ingestion/app.py .
EXPOSE 8091
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8091","--workers","1"]
