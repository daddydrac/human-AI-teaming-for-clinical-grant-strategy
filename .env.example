# Organization / document configuration
ORGANIZATION_NAME="Research Clinic Cancer Center"
GRANT_SECTIONS="Specific Aims,Significance,Innovation,Approach,Human Subjects,Environment"
GRANT_WRITER_HOME=./workspace

# Application-owned accounts. On the first ./start.sh run a cryptographically
# random setup token is appended to the private .env file and shown once.
AUTH_MODE=internal_accounts
INITIAL_ADMIN_SETUP_TOKEN=
AUTH_SESSION_TTL_SECONDS=43200
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_MIN_LENGTH=14
PASSWORD_MAX_LENGTH=256
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
APP_PUBLIC_URL=http://127.0.0.1:7860
SESSION_COOKIE_SECURE=false
TRUSTED_PROXY_IPS=127.0.0.1

# Enterprise OIDC gateway. These values are used only with
# scripts/start_oidc_gateway.sh. Secret and TLS files are mounted read-only;
# keep them outside version control. The user ID claim must be immutable.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_FILE=./.secrets/oidc-client-secret
OIDC_COOKIE_SECRET_FILE=./.secrets/oidc-cookie-secret
OIDC_GATEWAY_SHARED_SECRET_FILE=./.secrets/oidc-gateway-shared-secret
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_USER_ID_CLAIM=sub
OIDC_EMAIL_CLAIM=email
OIDC_SCOPES="openid profile email"
OIDC_PUBLIC_HOST=
OIDC_ORGANIZATION_ID=
OIDC_TLS_CERT_FILE=./.secrets/tls.crt
OIDC_TLS_KEY_FILE=./.secrets/tls.key
OIDC_BIND_ADDRESS=0.0.0.0
OIDC_HTTPS_PORT=8443
OIDC_SESSION_TTL=12h
OIDC_SESSION_REFRESH=0

# SMTP is mandatory in internal_accounts mode so invitations and password-reset
# links are actually delivered. Configure an institution-managed SMTP relay;
# the application container is the SMTP client and does not itself provide an
# Internet mail server. STARTTLS is the default (normally port 587). Use `tls`
# for implicit TLS (normally port 465), or `none` only for a trusted local relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
# Bounds: 1..120 seconds. Applies to SMTP connection and delivery operations.
SMTP_TIMEOUT_SECONDS=30
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional cloud escalation
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Local model transport. The portable deployment uses the Ollama container.
# Structured tasks use Ollama's JSON Schema format and the shared core validator.
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL_REPO=
LOCAL_LLM_MODEL_REVISION=
LOCAL_LLM_API_MODEL=qwen3:1.7b
LOCAL_LLM_URL=http://ollama:11434/v1/chat/completions
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_PROMPT_PREFIX=

# Backward-compatible OLMo names used by older deployments.
OLMO_MODEL_REPO=
OLMO_API_MODEL=qwen3:1.7b
# Optional immutable Hugging Face git revision; leave blank to resolve and record the current repo SHA at startup.
OLMO_MODEL_REVISION=
EMBEDDING_API_MODEL=grant-embedding-cpu
EMBEDDING_MODEL_REVISION=
EMBEDDING_URL=http://embedding-cpu:8010/v1/embeddings
EMBEDDING_BATCH_SIZE=4
EMBEDDING_HTTP_TIMEOUT_SECONDS=120
EMBEDDING_HEALTH_TTL_SECONDS=600
INDEX_EMBED_BATCH_RECORDS=4
MODEL_HTTP_TIMEOUT_SECONDS=300
OLMO_MAX_TOKENS=4096
CLAUDE_MAX_TOKENS=6000
CLAUDE_TASK_KINDS=requirement_decomposition,sponsor_compliance_compilation,investigator_interview,research_planning,evidence_validation,competitor_profile,competitive_positioning,complex_scientific_synthesis,review_simulation,causal_analysis

# Parallelism. scripts/tune_mac.sh can set better machine-specific values.
OMP_NUM_THREADS=4
RAYON_NUM_THREADS=4
OPENBLAS_NUM_THREADS=1

# Research
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
RESEARCH_USER_AGENT=ClinicalGrantWorkbench/0.8.0
RESEARCH_MAX_CONCURRENCY=8
RESEARCH_HTTP_TIMEOUT_SECONDS=30
RESEARCH_MAX_BODY_BYTES=8388608

# Document ingestion / context
DOCUMENT_INGESTION_URL=http://ingestion:8091/extract
INGESTION_HTTP_TIMEOUT_SECONDS=90
INGESTION_NAVIGATION_TIMEOUT_MS=45000
INGESTION_MAX_OUTPUT_BYTES=8388608
INGESTION_MAX_CONCURRENCY=2
DOCUMENT_CHUNK_WORDS=420
DOCUMENT_CHUNK_OVERLAP_WORDS=64
CONTEXT_RETRIEVAL_K=24
CONTEXT_MAX_CHARS=48000

# Retrieval calibration; configuration, not code constants.
RETRIEVAL_WEIGHT_SEMANTIC=0.45
RETRIEVAL_WEIGHT_LEXICAL=0.25
RETRIEVAL_WEIGHT_EVIDENCE=0.20
RETRIEVAL_WEIGHT_FRESHNESS=0.10
RETRIEVAL_GRAPH_BOOST=0.08
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_OPENMP_THRESHOLD=4096
RETRIEVAL_FRESHNESS_HALF_LIFE_DAYS=365
BM25_K1=1.2
BM25_B=0.75

# Clinical feasibility scenario sweep safety limit
CLINICAL_SCENARIO_MAX_COMBINATIONS=10000

# Phase 6 · public competitive applicant intelligence
COMPETITIVE_CONFIG_PATH=/app/config/competitive_intelligence.json
WORKFLOW_DEFINITIONS_PATH=/app/config/workflow_definitions.json
COMPETITIVE_HTTP_TIMEOUT_SECONDS=45
# Re-query public competitive sources automatically every 4 hours by default.
COMPETITIVE_REFRESH_TTL_SECONDS=14400
# Background self-healing continues while the Docker stack is running, even if Gradio is closed.
COMPETITIVE_BACKGROUND_REFRESH_ENABLED=true
COMPETITIVE_BACKGROUND_REFRESH_SECONDS=14400
# The open Gradio UI polls only for status; expensive public refreshes remain TTL-gated by the core.
COMPETITIVE_UI_POLL_SECONDS=14400
COLLABORATION_UI_POLL_SECONDS=5
COMPETITIVE_UPDATE_LABEL="Competitive Edge Auto-Update"
COMPETITIVE_USER_AGENT=GrantWriterCompetitive/1.0
# Comma-separated aliases excluded from potential-competitor results. Customize for the deploying institution.
COMPETITIVE_HOME_ORGANIZATION_ALIASES="Research Clinic Cancer Center,University of Texas Research Clinic Cancer Center,UT Research Clinic Cancer Center"
# Recommended by OpenAlex for polite-pool identification; use an institutional/service email if available.
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Runtime selection. Apple Silicon uses containerized Ollama plus containerized
# CPU embeddings. docker_cpu uses Claude plus the same embedding container.
GRANT_RUNTIME_PROFILE=container_ollama
MODEL_ROUTING_MODE=hybrid
# Set true when a deployment requires both OLMo and Claude to be available.
REQUIRE_CLAUDE_IN_HYBRID=false

# CPU-only weak-Mac embedding fallback (activated automatically by start.sh when needed)
CPU_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CPU_EMBEDDING_API_MODEL=grant-embedding-cpu
CPU_EMBEDDING_THREADS=2
CPU_EMBEDDING_BATCH_SIZE=8

# Optional container memory ceilings; scripts/configure_runtime.sh tunes these by machine profile.
CORE_MEMORY_LIMIT=1536m
UI_MEMORY_LIMIT=768m
RENDERER_MEMORY_LIMIT=768m
INGESTION_MEMORY_LIMIT=1g
EMBEDDING_MEMORY_LIMIT=768m

# Final DOCX/PDF artifacts are bind-mounted here so users can open them directly on the Mac.
# Hot SQLite/MMAP/Parquet data stays in Docker named volumes for much faster macOS I/O.
GRANT_EXPORT_HOME=./exports

# Phase 8 · build/release metadata and resource ceilings
GRANT_BUILD_VERSION=0.8.0
GRANT_BUILD_REVISION=development
CORE_CPU_LIMIT=4.0
UI_CPU_LIMIT=1.0
RENDERER_CPU_LIMIT=1.5
INGESTION_CPU_LIMIT=1.5
EMBEDDING_CPU_LIMIT=2.0
BACKUP_DIR=./backups
BENCHMARK_OUTPUT_DIR=./benchmarks
RELEASE_DIR=./releases
# Set true only in release CI when a cryptographic signing key/tool is configured.
REQUIRE_RELEASE_SIGNATURE=false
