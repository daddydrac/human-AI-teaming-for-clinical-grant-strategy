# syntax=docker/dockerfile:1.7
ARG APP_VERSION=0.8.0
FROM python:3.12-slim
ARG APP_VERSION
LABEL org.opencontainers.image.title="Research Clinic Grant Agent" org.opencontainers.image.version="${APP_VERSION}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false FASTEMBED_CACHE_PATH=/models
WORKDIR /app
COPY embedding_cpu/requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements.txt
COPY embedding_cpu/app.py .
EXPOSE 8010
CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8010","--workers","1","--no-access-log"]
